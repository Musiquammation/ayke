{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"client/**/*.ts",
		"server/**/*.ts",
		"commons/**/*.ts",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"client/dist"
	]
}
